Import('env', 'arch')

# Hardware H.264 for Android Auto projection (Qualcomm V4L2). Loaded with ctypes by
# hw_encoder.py; android_autod falls back to libx264 when it is missing.
if arch == "larch64":
  env.SharedLibrary('hw/aa_encoder', ['hw/aa_encoder.cc'])
  if GetOption('extras'):
    env.Program('hw/test_rgba_to_nv12', ['hw/test_rgba_to_nv12.cc'])
